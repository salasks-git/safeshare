{
  "name": "safe-drop",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_DO", "class_name": "RoomDO" },
      { "name": "LIMITER_DO", "class_name": "LimiterDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO", "LimiterDO"]
    }
  ],
  "kv_namespaces": [
    { "binding": "FILES_KV", "id": "acc5157e8f6944538a5a8c44d75f060b" }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "MAX_FILE_SIZE_BYTES": 15728640,
    "MAX_FILES_PER_ROOM": 20,
    "MAX_TOTAL_BYTES_PER_ROOM": 52428800,
    "ROOM_IDLE_TIMEOUT_MS": 900000,
    "ROOM_MAX_LIFETIME_MS": 3600000,
    "ROOM_CODE_WAIT_TIMEOUT_MS": 300000
  }
}
